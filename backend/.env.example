# Copy to .env and fill in. Nothing here is a real secret.

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:8081
API_URL=http://localhost:4000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=milaan

# --- JWT --- any two long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# --- SMS (Twilio) ---
# Leave blank in development: codes print to the server console instead of
# being sent. The sender must be able to deliver to Indian numbers; for an
# Indian audience a DLT-registered sender ID is usually required in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# --- Email (Resend) --- only used by the older email-OTP path
RESEND_API_KEY=
RESEND_FROM_EMAIL=Milaan <onboarding@milaan.in>

# --- Social sign-in --- fill in only the ones you want to enable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Web push --- `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@milaan.in
