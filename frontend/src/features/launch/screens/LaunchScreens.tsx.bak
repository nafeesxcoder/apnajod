import { useEffect, useRef } from "react";
import {
  View,
  Text,
  Animated,
  Easing,
  StyleSheet,
  Dimensions,
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import { Ionicons } from "@expo/vector-icons";
import { LinearGradient } from "expo-linear-gradient";

const PINK = "#E91E63";
const PINK_LIGHT = "#FCE4EC";
const PINK_DARK = "#880E4F";
const WHITE = "#FFFFFF";

const { width } = Dimensions.get("window");

export function SplashScreen() {
  // Animation Values
  const ringScale = useRef(new Animated.Value(0.8)).current;
  const ringOpacity = useRef(new Animated.Value(0)).current;
  const pulseAnim = useRef(new Animated.Value(1)).current;
  const logoScale = useRef(new Animated.Value(0)).current;
  const textOpacity = useRef(new Animated.Value(0)).current;
  const textSlide = useRef(new Animated.Value(20)).current;
  const sparkleOpacity = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    // 1. Ring fades in
    Animated.timing(ringOpacity, {
      toValue: 1,
      duration: 800,
      useNativeDriver: true,
    }).start();

    // 2. Ring pulse loop (dhak-dhak)
    Animated.loop(
      Animated.sequence([
        Animated.timing(pulseAnim, {
          toValue: 1.1,
          duration: 1000,
          easing: Easing.inOut(Easing.ease),
          useNativeDriver: true,
        }),
        Animated.timing(pulseAnim, {
          toValue: 1,
          duration: 1000,
          easing: Easing.inOut(Easing.ease),
          useNativeDriver: true,
        }),
      ]),
    ).start();

    // 3. Logo pops in
    Animated.spring(logoScale, {
      toValue: 1,
      friction: 4,
      tension: 60,
      delay: 300,
      useNativeDriver: true,
    }).start();

    // 4. Text fades in
    Animated.parallel([
      Animated.timing(textOpacity, {
        toValue: 1,
        duration: 800,
        delay: 800,
        useNativeDriver: true,
      }),
      Animated.timing(textSlide, {
        toValue: 0,
        duration: 800,
        delay: 800,
        easing: Easing.out(Easing.ease),
        useNativeDriver: true,
      }),
    ]).start();

    // 5. Sparkles fade in
    Animated.timing(sparkleOpacity, {
      toValue: 1,
      duration: 1200,
      delay: 1000,
      useNativeDriver: true,
    }).start();
  }, []);

  return (
    <LinearGradient
      colors={["#FFF0F5", PINK_LIGHT, "#FFF5F9"]}
      style={{ flex: 1 }}
    >
      <SafeAreaView style={{ flex: 1 }}>
        <View style={styles.container}>
          {/* Decorative Sparkles (Background) */}
          <Animated.View
            style={[
              styles.sparkle,
              { top: 100, left: 60, opacity: sparkleOpacity },
            ]}
          >
            <Ionicons name="sparkles" size={20} color={PINK} />
          </Animated.View>
          <Animated.View
            style={[
              styles.sparkle,
              { top: 160, right: 80, opacity: sparkleOpacity },
            ]}
          >
            <Ionicons name="sparkles" size={16} color={PINK} />
          </Animated.View>
          <Animated.View
            style={[
              styles.sparkle,
              { bottom: 220, left: 100, opacity: sparkleOpacity },
            ]}
          >
            <Ionicons name="star" size={14} color={PINK} />
          </Animated.View>
          <Animated.View
            style={[
              styles.sparkle,
              { bottom: 180, right: 60, opacity: sparkleOpacity },
            ]}
          >
            <Ionicons name="sparkles" size={22} color={PINK} />
          </Animated.View>

          {/* Center Content */}
          <View style={styles.centerContent}>
            {/* Pulsing Ring with Logo inside */}
            <Animated.View
              style={[
                styles.ringContainer,
                {
                  opacity: ringOpacity,
                  transform: [{ scale: pulseAnim }],
                },
              ]}
            >
              {/* Outer ring (glow) */}
              <View style={styles.ringOuter} />
              {/* Inner ring (border) */}
              <View style={styles.ringInner} />
              {/* Logo Circle */}
              <Animated.View
                style={[
                  styles.logoCircle,
                  { transform: [{ scale: logoScale }] },
                ]}
              >
                <Ionicons name="heart" size={56} color={WHITE} />
              </Animated.View>
            </Animated.View>

            {/* Text Area */}
            <Animated.View
              style={[
                styles.textArea,
                {
                  opacity: textOpacity,
                  transform: [{ translateY: textSlide }],
                },
              ]}
            >
              <Text style={styles.appName}>ApnaJod</Text>
              <Text style={styles.tagline}>Find Your Perfect Match</Text>
            </Animated.View>
          </View>
        </View>
      </SafeAreaView>
    </LinearGradient>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    justifyContent: "center",
    alignItems: "center",
  },
  centerContent: {
    alignItems: "center",
    justifyContent: "center",
  },
  ringContainer: {
    width: 200,
    height: 200,
    justifyContent: "center",
    alignItems: "center",
    marginBottom: 40,
  },
  ringOuter: {
    position: "absolute",
    width: 200,
    height: 200,
    borderRadius: 100,
    backgroundColor: "rgba(233, 30, 99, 0.08)",
  },
  ringInner: {
    position: "absolute",
    width: 160,
    height: 160,
    borderRadius: 80,
    borderWidth: 2,
    borderColor: "rgba(233, 30, 99, 0.25)",
  },
  logoCircle: {
    width: 110,
    height: 110,
    borderRadius: 55,
    backgroundColor: PINK,
    justifyContent: "center",
    alignItems: "center",
    shadowColor: PINK,
    shadowOffset: { width: 0, height: 0 },
    shadowOpacity: 0.5,
    shadowRadius: 20,
    elevation: 10,
  },
  textArea: {
    alignItems: "center",
  },
  appName: {
    fontSize: 42,
    fontWeight: "800",
    color: PINK_DARK,
    letterSpacing: 2,
    marginBottom: 8,
  },
  tagline: {
    fontSize: 15,
    color: "#635A5D",
    letterSpacing: 1,
    fontWeight: "500",
  },
  sparkle: {
    position: "absolute",
  },
});
