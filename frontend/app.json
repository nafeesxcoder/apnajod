{
  "expo": {
    "name": "Apnajoda",
    "slug": "apnajoda",
    "version": "1.0.0",
    "description": "Serious, verified dating for India. Built for people looking for a real relationship, not casual swiping.",
    "icon": "./assets/icon.png",
    "scheme": "apnajoda",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "primaryColor": "#1F4D7A",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FDF7F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apnajoda.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.apnajoda.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF7F4"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Apnajoda",
      "shortName": "Apnajoda",
      "themeColor": "#1F4D7A",
      "backgroundColor": "#FDF7F4"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Apnajoda needs photo access so you can build your relationship profile.",
          "cameraPermission": "Apnajoda uses the camera for profile photos and selfie verification."
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Apnajoda uses the microphone to record your optional voice introduction.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Apnajoda uses approximate location only when you enable Crossed Paths. Your exact location is never shown to other members.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Apnajoda uses your contacts to help you find friends who are already on the app. Your contact list is never stored on our servers."
        }
      ]
    ],
    "locales": {}
  }
}
