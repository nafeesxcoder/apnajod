{
  "expo": {
    "name": "Apnajoda",
    "slug": "apnajoda",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87ac25e0-158f-40b7-8e89-7c0873bddee9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "description": "Serious, verified dating for India. Built for people looking for a real relationship, not casual swiping.",
    "icon": "./assets/icon.png",
    "scheme": "apnajoda",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "primaryColor": "#B0245F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FBF4FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apnajoda.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.apnajoda.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF4FF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Apnajoda",
      "shortName": "Apnajoda",
      "themeColor": "#FBF4FF",
      "backgroundColor": "#FBF4FF"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Apnajoda needs photo access so you can build your relationship profile.",
          "cameraPermission": "Apnajoda uses the camera for profile photos and selfie verification."
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Apnajoda uses the microphone to record your optional voice introduction.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Apnajoda uses approximate location only when you enable Crossed Paths. Your exact location is never shown to other members.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Apnajoda uses your contacts to help you find friends who are already on the app. Your contact list is never stored on our servers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B0245F"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Apnajoda uses the camera for video calls with your matches.",
          "microphonePermission": "Apnajoda uses the microphone for voice and video calls with your matches."
        }
      ]
    ],
    "locales": {},
    "extra": {
      "buildVariant": "production",
      "eas": {
        "projectId": "87ac25e0-158f-40b7-8e89-7c0873bddee9"
      }
    },
    "owner": "nafarhaofficials-team"
  }
}
